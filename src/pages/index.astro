---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="page">
    <header class="intro">
      <h1>Kristijan Bambir</h1>
      <p class="summary">
        Web developer from Croatia with 15+ years of experience.
      </p>
      <p class="work">
        Currently Frontend Lead at <a href="https://vumedi.com">Vumedi</a>.
        Previously Frontend Team Lead at <a
          href="https://corporate.aboutyou.de/en/">ABOUT YOU</a
        > and JavaScript Team Lead at <a href="https://infinum.com">Infinum</a>.
      </p>
    </header>

    <section class="section" aria-labelledby="links-heading">
      <h2 id="links-heading">Around the web</h2>
      <ul class="links">
        <li><a href="https://github.com/kristijanbambir">GitHub</a></li>
        <li>
          <a href="https://www.linkedin.com/in/kristijanbambir">LinkedIn</a>
        </li>
        <li>
          <a href="https://www.instagram.com/kristijanbambir/">Instagram</a>
        </li>
        <li><a href="mailto:kristijan.bambir@gmail.com">Email</a></li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  .page {
    width: min(100%, 680px);
    min-height: 100svh;
    margin: 0 auto;
    padding: clamp(72px, 15vh, 144px) 0 40px;
    display: flex;
    flex-direction: column;
  }

  .intro {
    max-width: 560px;
  }

  .eyebrow {
    margin-bottom: 22px;
    color: var(--muted-color);
    font-size: 0.82rem;
  }

  h1 {
    margin-bottom: 24px;
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }

  .summary,
  .work {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .summary {
    margin-bottom: 14px;
  }

  .work {
    color: var(--muted-color);
  }

  .section {
    margin-top: clamp(56px, 10vh, 88px);
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
  }

  h2 {
    margin-bottom: 18px;
    color: var(--muted-color);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 24px;
    row-gap: 12px;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 720px) {
    .page {
      padding-top: 72px;
    }
  }
</style>
